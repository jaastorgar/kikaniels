{
  "appId": "cl.beautyhogar.app",
  "appName": "Beauty Hogar",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#2C0140",
      "androidSplashResourceName": "splash",
      "showSpinner": true,
      "spinnerColor": "#0AE8C6"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#2C0140"
    }
  }
}
